<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kk_bg_gifts"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/kk_logo" android:contentDescription="Kadokoli" />
        <TextView android:id="@+id/kk_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="À dépenser" android:textColor="#F2FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/kk_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="202 €" android:textColor="#FFFFFF" android:textSize="34sp" android:fontFamily="sans-serif-black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="40sp" />
    <TextView android:id="@+id/kk_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/kk_pill" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:text="1 expire ce mois-ci" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
